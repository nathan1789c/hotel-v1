rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(email) {
      return email is string &&
        email.size() >= 3 &&
        email.size() <= 150 &&
        email.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return isVerified() &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() in [
          'nathan.bui1789@gmail.com',
          'thaihahuyhotel.com@gmail.com'
        ];
    }

    function isPermissionAdmin() {
      return isVerified() &&
        request.auth.token.email is string &&
        isValidEmailId(request.auth.token.email.lower()) &&
        exists(/databases/$(database)/documents/permissions/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/permissions/$(request.auth.token.email.lower())).data.role == 'admin';
    }

    function isAdmin() {
      return isSuperAdmin() ||
        isPermissionAdmin() ||
        (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isAuthorizedUser() {
      return isSuperAdmin() || (
        isVerified() &&
        request.auth.token.email is string &&
        isValidEmailId(request.auth.token.email.lower()) &&
        exists(/databases/$(database)/documents/permissions/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/permissions/$(request.auth.token.email.lower())).data.role in ['admin', 'staff']
      );
    }

    function isSharedWorkspace(hotelId) {
      return hotelId == 'hotel-thai-ha-huy-25';
    }

    function isValidPermission(data, permissionEmail) {
      return data.keys().hasAll([
        'email',
        'role',
        'addedBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'email',
        'role',
        'displayName',
        'addedBy',
        'updatedBy',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidEmailId(data.email) &&
      data.email == permissionEmail &&
      data.role in ['admin', 'staff'] &&
      (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
      data.addedBy is string && data.addedBy.size() >= 1 && data.addedBy.size() <= 150 &&
      (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 150)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidHotelWorkspace(data, hotelId) {
      return data.keys().hasAll([
        'ownerUid',
        'hotelName',
        'hotelAddress',
        'hotelPhone',
        'hotelEmail',
        'defaultManagementFee',
        'channelCommissions',
        'pricingFormula',
        'roundingMethod',
        'servicesList',
        'hourlyRates',
        'serverCreatedAt',
        'serverUpdatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerUid',
        'hotelName',
        'hotelAddress',
        'hotelPhone',
        'hotelEmail',
        'defaultManagementFee',
        'channelCommissions',
        'pricingFormula',
        'roundingMethod',
        'servicesList',
        'hourlyRates',
        'serverCreatedAt',
        'serverUpdatedAt'
      ]) &&
      isValidId(data.ownerUid) &&
      data.ownerUid == hotelId &&
      isSharedWorkspace(hotelId) &&
      data.hotelName is string && data.hotelName.size() >= 1 && data.hotelName.size() <= 120 &&
      data.hotelAddress is string && data.hotelAddress.size() <= 300 &&
      data.hotelPhone is string && data.hotelPhone.size() <= 40 &&
      data.hotelEmail is string && data.hotelEmail.size() <= 120 &&
      data.defaultManagementFee is number && data.defaultManagementFee >= 0 && data.defaultManagementFee <= 100000000 &&
      data.channelCommissions is map &&
      data.pricingFormula in ['net_guaranteed', 'simple_markup'] &&
      data.roundingMethod in ['1000', '10000', 'none'] &&
      data.servicesList is list && data.servicesList.size() <= 100 &&
      (data.servicesList.size() == 0 || data.servicesList[0] is map) &&
      data.hourlyRates is map &&
      data.serverCreatedAt is timestamp &&
      data.serverUpdatedAt is timestamp;
    }

    function isValidRoom(data, hotelId, roomId) {
      return data.keys().hasAll([
        'id',
        'ownerUid',
        'number',
        'floor',
        'type',
        'status',
        'bedDescription',
        'directPrice',
        'serverCreatedAt',
        'serverUpdatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'ownerUid',
        'number',
        'floor',
        'type',
        'status',
        'bedDescription',
        'directPrice',
        'currentBookingId',
        'cleaningNote',
        'cleaningMonth',
        'lastCleanedAt',
        'serverCreatedAt',
        'serverUpdatedAt'
      ]) &&
      isValidId(data.id) && data.id == roomId &&
      isValidId(data.ownerUid) &&
      data.ownerUid == hotelId &&
      isSharedWorkspace(hotelId) &&
      data.number is string && data.number.size() >= 1 && data.number.size() <= 20 &&
      data.floor is number && data.floor >= 1 && data.floor <= 50 &&
      data.type in ['standard_single', 'standard_twin', 'vip', 'deluxe', 'family'] &&
      data.status in ['available', 'occupied', 'reserved', 'cleaning', 'maintenance'] &&
      data.bedDescription is string && data.bedDescription.size() <= 120 &&
      data.directPrice is number && data.directPrice >= 0 && data.directPrice <= 100000000 &&
      (!('currentBookingId' in data) || (data.currentBookingId is string && data.currentBookingId.size() <= 128)) &&
      (!('cleaningNote' in data) || (data.cleaningNote is string && data.cleaningNote.size() <= 300)) &&
      (!('cleaningMonth' in data) || (data.cleaningMonth is string && data.cleaningMonth.size() <= 20)) &&
      (!('lastCleanedAt' in data) || (data.lastCleanedAt is string && data.lastCleanedAt.size() <= 40)) &&
      data.serverCreatedAt is timestamp &&
      data.serverUpdatedAt is timestamp;
    }

    function isValidBooking(data, hotelId, bookingId) {
      return data.keys().hasAll([
        'id',
        'ownerUid',
        'bookingCode',
        'roomId',
        'roomNumber',
        'roomType',
        'guestName',
        'guestPhone',
        'channel',
        'checkInDate',
        'checkOutDate',
        'nights',
        'roomPricePerNight',
        'totalRoomPrice',
        'managementFee',
        'otaCommissionRate',
        'otaCommissionAmount',
        'services',
        'deposit',
        'discount',
        'status',
        'createdAt',
        'serverCreatedAt',
        'serverUpdatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'ownerUid',
        'bookingCode',
        'roomId',
        'roomNumber',
        'roomType',
        'guestName',
        'guestPhone',
        'guestIdCard',
        'channel',
        'channelBookingRef',
        'stayType',
        'checkInDate',
        'checkOutDate',
        'checkInTime',
        'checkOutTime',
        'nights',
        'hours',
        'hourlyBasePrice',
        'hourlyExtraPrice',
        'roomPricePerNight',
        'totalRoomPrice',
        'managementFee',
        'otaCommissionRate',
        'otaCommissionAmount',
        'services',
        'deposit',
        'discount',
        'status',
        'notes',
        'createdAt',
        'checkedOutAt',
        'cancelledAt',
        'paymentMethod',
        'serverCreatedAt',
        'serverUpdatedAt'
      ]) &&
      isValidId(data.id) && data.id == bookingId &&
      isValidId(data.ownerUid) &&
      data.ownerUid == hotelId &&
      isSharedWorkspace(hotelId) &&
      data.bookingCode is string && data.bookingCode.size() >= 1 && data.bookingCode.size() <= 64 &&
      isValidId(data.roomId) &&
      data.roomNumber is string && data.roomNumber.size() >= 1 && data.roomNumber.size() <= 20 &&
      data.roomType in ['standard_single', 'standard_twin', 'vip', 'deluxe', 'family'] &&
      data.guestName is string && data.guestName.size() >= 1 && data.guestName.size() <= 150 &&
      data.guestPhone is string && data.guestPhone.size() <= 40 &&
      (!('guestIdCard' in data) || (data.guestIdCard is string && data.guestIdCard.size() <= 50)) &&
      data.channel in ['direct', 'agoda', 'booking', 'trip', 'airbnb'] &&
      (!('channelBookingRef' in data) || (data.channelBookingRef is string && data.channelBookingRef.size() <= 80)) &&
      (!('stayType' in data) || data.stayType in ['nightly', 'hourly']) &&
      data.checkInDate is string && data.checkInDate.size() >= 8 && data.checkInDate.size() <= 20 &&
      data.checkOutDate is string && data.checkOutDate.size() >= 8 && data.checkOutDate.size() <= 20 &&
      (!('checkInTime' in data) || (data.checkInTime is string && data.checkInTime.size() <= 20)) &&
      (!('checkOutTime' in data) || (data.checkOutTime is string && data.checkOutTime.size() <= 20)) &&
      data.nights is number && data.nights >= 0 && data.nights <= 3650 &&
      (!('hours' in data) || (data.hours is number && data.hours >= 1 && data.hours <= 720)) &&
      (!('hourlyBasePrice' in data) || (data.hourlyBasePrice is number && data.hourlyBasePrice >= 0 && data.hourlyBasePrice <= 100000000)) &&
      (!('hourlyExtraPrice' in data) || (data.hourlyExtraPrice is number && data.hourlyExtraPrice >= 0 && data.hourlyExtraPrice <= 100000000)) &&
      data.roomPricePerNight is number && data.roomPricePerNight >= 0 && data.roomPricePerNight <= 100000000 &&
      data.totalRoomPrice is number && data.totalRoomPrice >= 0 && data.totalRoomPrice <= 1000000000 &&
      data.managementFee is number && data.managementFee >= 0 && data.managementFee <= 100000000 &&
      data.otaCommissionRate is number && data.otaCommissionRate >= 0 && data.otaCommissionRate <= 1 &&
      data.otaCommissionAmount is number && data.otaCommissionAmount >= 0 && data.otaCommissionAmount <= 1000000000 &&
      data.services is list && data.services.size() <= 50 &&
      (data.services.size() == 0 || data.services[0] is map) &&
      data.deposit is number && data.deposit >= 0 && data.deposit <= 1000000000 &&
      data.discount is number && data.discount >= 0 && data.discount <= 1000000000 &&
      data.status in ['active', 'reserved', 'completed', 'cancelled'] &&
      (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
      data.createdAt is string && data.createdAt.size() <= 64 &&
      (!('checkedOutAt' in data) || (data.checkedOutAt is string && data.checkedOutAt.size() <= 64)) &&
      (!('cancelledAt' in data) || (data.cancelledAt is string && data.cancelledAt.size() <= 64)) &&
      (!('paymentMethod' in data) || data.paymentMethod in ['cash', 'transfer', 'card', 'ota_collect']) &&
      data.serverCreatedAt is timestamp &&
      data.serverUpdatedAt is timestamp;
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && isVerified() && (request.auth.uid == userId || isAdmin());
      allow list: if isVerified() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Staff & Admin permissions directory (keyed by normalized lowercase email)
    match /permissions/{permissionEmail} {
      // Users can read only their own permission doc; Admins can read any permission doc
      allow get: if isValidEmailId(permissionEmail) &&
        isVerified() &&
        (isAdmin() || (request.auth.token.email is string && request.auth.token.email.lower() == permissionEmail));

      // Only Admins can list all authorized staff/admin accounts
      allow list: if isAdmin() && resource.data.email is string;

      // Only Admins can add authorized users; Super Admins cannot be created as non-admin
      allow create: if isValidEmailId(permissionEmail) &&
        isAdmin() &&
        isValidPermission(incoming(), permissionEmail) &&
        (!(permissionEmail in ['nathan.bui1789@gmail.com', 'thaihahuyhotel.com@gmail.com']) || incoming().role == 'admin') &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      // Only Admins can update non-super-admin accounts
      allow update: if isValidEmailId(permissionEmail) &&
        isAdmin() &&
        !(permissionEmail in ['nathan.bui1789@gmail.com', 'thaihahuyhotel.com@gmail.com']) &&
        isValidPermission(incoming(), permissionEmail) &&
        incoming().email == existing().email &&
        incoming().addedBy == existing().addedBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'role',
          'displayName',
          'updatedBy',
          'updatedAt'
        ]);

      // Only Admins can revoke/delete accounts, and default Super Admins can never be deleted
      allow delete: if isValidEmailId(permissionEmail) &&
        isAdmin() &&
        !(permissionEmail in ['nathan.bui1789@gmail.com', 'thaihahuyhotel.com@gmail.com']);
    }

    match /hotels/{hotelId} {
      allow get: if isValidId(hotelId) &&
        isAuthorizedUser() &&
        isSharedWorkspace(hotelId) &&
        (resource == null || existing().ownerUid == hotelId);
      allow list: if isAuthorizedUser() && isSharedWorkspace(hotelId) && resource.data.ownerUid == hotelId;

      allow create: if isValidId(hotelId) &&
        isAuthorizedUser() &&
        isSharedWorkspace(hotelId) &&
        isValidHotelWorkspace(incoming(), hotelId) &&
        incoming().serverCreatedAt == request.time &&
        incoming().serverUpdatedAt == request.time;

      // Only Admins can update hotel settings, OTA pricing formulas, hourly rates, or service catalogs
      allow update: if isValidId(hotelId) &&
        isAdmin() &&
        isSharedWorkspace(hotelId) &&
        isValidHotelWorkspace(incoming(), hotelId) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().serverCreatedAt == existing().serverCreatedAt &&
        incoming().serverUpdatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'hotelName',
          'hotelAddress',
          'hotelPhone',
          'hotelEmail',
          'defaultManagementFee',
          'channelCommissions',
          'pricingFormula',
          'roundingMethod',
          'servicesList',
          'hourlyRates',
          'serverUpdatedAt'
        ]);

      allow delete: if isValidId(hotelId) && isAdmin();

      match /rooms/{roomId} {
        allow get: if isValidId(hotelId) &&
          isValidId(roomId) &&
          isAuthorizedUser() &&
          isSharedWorkspace(hotelId) &&
          (resource == null || existing().ownerUid == hotelId);
        allow list: if isAuthorizedUser() && isSharedWorkspace(hotelId) && resource.data.ownerUid == hotelId;

        allow create: if isValidId(hotelId) &&
          isValidId(roomId) &&
          isAuthorizedUser() &&
          isSharedWorkspace(hotelId) &&
          exists(/databases/$(database)/documents/hotels/$(hotelId)) &&
          isValidRoom(incoming(), hotelId, roomId) &&
          incoming().serverCreatedAt == request.time &&
          incoming().serverUpdatedAt == request.time;

        // Tiered update: Staff may update operational room statuses only; Admins may also edit room pricing & configuration
        allow update: if isValidId(hotelId) &&
          isValidId(roomId) &&
          isAuthorizedUser() &&
          isSharedWorkspace(hotelId) &&
          exists(/databases/$(database)/documents/hotels/$(hotelId)) &&
          isValidRoom(incoming(), hotelId, roomId) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().id == existing().id &&
          incoming().serverCreatedAt == existing().serverCreatedAt &&
          incoming().serverUpdatedAt == request.time &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'currentBookingId',
              'cleaningNote',
              'cleaningMonth',
              'lastCleanedAt',
              'serverUpdatedAt'
            ]) ||
            (
              isAdmin() &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'number',
                'floor',
                'type',
                'bedDescription',
                'directPrice',
                'status',
                'currentBookingId',
                'cleaningNote',
                'cleaningMonth',
                'lastCleanedAt',
                'serverUpdatedAt'
              ])
            )
          );

        allow delete: if isValidId(hotelId) && isValidId(roomId) && isAdmin();
      }

      match /bookings/{bookingId} {
        allow get: if isValidId(hotelId) &&
          isValidId(bookingId) &&
          isAuthorizedUser() &&
          isSharedWorkspace(hotelId) &&
          (resource == null || existing().ownerUid == hotelId);
        allow list: if isAuthorizedUser() && isSharedWorkspace(hotelId) && resource.data.ownerUid == hotelId;

        allow create: if isValidId(hotelId) &&
          isValidId(bookingId) &&
          isAuthorizedUser() &&
          isSharedWorkspace(hotelId) &&
          exists(/databases/$(database)/documents/hotels/$(hotelId)/rooms/$(incoming().roomId)) &&
          isValidBooking(incoming(), hotelId, bookingId) &&
          incoming().serverCreatedAt == request.time &&
          incoming().serverUpdatedAt == request.time;

        allow update: if isValidId(hotelId) &&
          isValidId(bookingId) &&
          isAuthorizedUser() &&
          isSharedWorkspace(hotelId) &&
          isValidBooking(incoming(), hotelId, bookingId) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().id == existing().id &&
          incoming().serverCreatedAt == existing().serverCreatedAt &&
          incoming().serverUpdatedAt == request.time &&
          (existing().status in ['active', 'reserved'] || isAdmin()) &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'services',
              'serverUpdatedAt'
            ]) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'stayType',
              'checkInDate',
              'checkOutDate',
              'checkInTime',
              'checkOutTime',
              'nights',
              'hours',
              'hourlyBasePrice',
              'hourlyExtraPrice',
              'roomId',
              'roomNumber',
              'roomType',
              'roomPricePerNight',
              'totalRoomPrice',
              'managementFee',
              'otaCommissionRate',
              'otaCommissionAmount',
              'deposit',
              'discount',
              'guestName',
              'guestPhone',
              'guestIdCard',
              'channel',
              'channelBookingRef',
              'notes',
              'services',
              'paymentMethod',
              'checkedOutAt',
              'cancelledAt',
              'serverUpdatedAt'
            ]) ||
            isAdmin()
          );

        allow delete: if isValidId(hotelId) && isValidId(bookingId) && isAdmin();
      }
    }
  }
}
